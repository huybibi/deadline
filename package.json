{
  "name": "deadline-widget",
  "productName": "deadline",
  "version": "0.2.1",
  "private": true,
  "description": "Widget quản lý deadline — bảng xếp hạng task theo hạn giao khách",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test store.test.js",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip --universal"
  },
  "build": {
    "appId": "vn.huybibi.deadline",
    "productName": "deadline",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "util.js",
      "seed.js",
      "renderer/**",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "deadline-${version}-portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "deadline-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1"
  }
}
