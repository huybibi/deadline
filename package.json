{
  "name": "deadline-widget",
  "productName": "deadline",
  "version": "0.1.0",
  "private": true,
  "description": "Widget quản lý deadline — bảng xếp hạng task theo hạn giao khách",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test store.test.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "vn.huybibi.deadline",
    "productName": "deadline",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "util.js",
      "renderer/**",
      "assets/icon.ico"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "deadline-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1"
  }
}
